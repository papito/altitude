<% import software.altitude.core.RequestContext %>
<% import software.altitude.core.models.Person %>
<% import software.altitude.core.Const %>
<% import software.altitude.core.Api %>

<%@ val people: List[Person] %>

<style>
    #people .cell {
        margin: 3px;
        padding-top: 3px;
        border: var(--result-border);
        border-radius: 5px;
        display: grid;
        width:<%= software.altitude.core.service.FaceDetectionService.faceDetectionBoxPx + 60 %>px;
        height: <%= software.altitude.core.service.FaceDetectionService.faceDetectionBoxPx + 40 %>px;
        place-items: center;
        touch-action: none;
        row-gap: 5px;
    }

    #people .cell img {
        display: block;
        border-radius: 20%;
    }

    #people .grid {
        margin: 10px;
        display: flex;
        flex-wrap: wrap;
        flex-direction: row;
        justify-content: center;
    }

    #people .name {
        display: grid;
        width: 100%;
        height: 100%;
        place-items: center;
        background-color: var(--background-tertiary-color);
    }

    #people .cell a {
        text-decoration: none;
        font-size: .9em;
        color: #FFFFFF;
        font-family: -apple-system, "system-ui", "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        letter-spacing: 1px;
    }

    #people .cell a.unknown {
        color: #fdda63;
    }
</style>

<div id="peopleList">
    <div id="people">
        <div class="grid">
            #for (person <- people)
            <div id="person-${person.persistedId}"
                 class="cell drag-drop dropzone"
                 alt-person-id="${person.persistedId}">
                <div class="image">
                    <a href="#"
                       hx-target="#content"
                       hx-trigger="click"
                       hx-swap="innerHTML"
                       hx-get='${ url(htmxSearchResults, Api.Field.REPO_ID -> RequestContext.getRepository.persistedId) }?${Api.Field.Search.PEOPLE_IDS}=${person.persistedId}'>
                    <img src="/content/r/${RequestContext.getRepository.persistedId}/${Const.DataStore.FACE}/${person.coverFaceId}">
                    </a>
                </div>
                <div class="name">
                    <span>
                        <a href="#"
                           #if (!person.isNamed)
                           class="unknown"
                           #end
                           hx-target="#content"
                           hx-trigger="click"
                           hx-swap="innerHTML"
                           hx-get='${ url(htmxSearchResults, Api.Field.REPO_ID -> RequestContext.getRepository.persistedId) }?${Api.Field.Search.PEOPLE_IDS}=${person.persistedId}'>
                            ${person.name.get}
                        </a>
                    </span>
                </div>
            </div>
            #end
        </div>
    </div>
</div>

<script type="module">
    import { selectTab } from "../../../../js/common/navigation.js"
    import { context } from "../../../../js/context.js"

    selectTab("explorer", "peopleTab")
    context.setRepoId("<%= RequestContext.getRepository.persistedId %>")
</script>

<script type="module" src="/js/people/event_handlers.js"></script>
<script type="module" src="/js/people/dragon-drop.js"></script>

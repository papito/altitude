<style>
    #batchSelector {
        display: grid;
        grid-template-columns: 2fr 2fr;
    }

    #batchSelector .container {
        display: flex;
        grid-column-start: 2;
        flex-direction: row;
        align-items: center;
        justify-content: flex-end;
        gap: 100px;
        padding-right: 100px;
        box-sizing: border-box;
    }

    #batchSelector .action-button {
        border-width: 1px;
        border-color: #222121;
        font-weight:  normal;
    }

    #batchSelector i {
        margin-right: 10px;
    }

    #batchSelector .batch-mover button {
        cursor: move;
    }

    #batchSelector .control button:hover {
        border-color: var(--warning-background-color);
    }

</style>

<div id="batchSelector" x-show="!$store.selectedAssets.isEmpty">
    <div class="container">
        <div class="control batch-mover">
            <button class="action-button success"><i class="fas fa-truck-moving"></i>Move&nbsp;(<span x-text="$store.selectedAssets.size"></span>)</button>
        </div>
        <div class="control">
            <button class="action-button success"><i class="fas fa-tools"></i>Actions</button>
        </div>
        <div class="control">
            <button class="action-button warning" @click="$dispatch(window.Const.events.deselectAll)"><i class="fas fa-toggle-off"></i>Deselect All</button>
        </div>
    </div>
</div>

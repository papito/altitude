<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <!-- encoders are assigned the type
             ch.qos.logback.classic.encoder.PatternLayoutEncoder by default -->
        <encoder>
            <pattern>%boldWhite(%d{HH:mm:ss.SSS}) %cyan(%X{REQUEST_ID}) %gray(%X{USER}) %highlight(%-5level) %logger{36}:%M:%L - %highlight(%msg) %n</pattern>
        </encoder>
    </appender>

    <root level="OFF">
        <appender-ref ref="STDOUT" />
    </root>

    <logger name="altitude" level="OFF" />
    <logger name="altitude.core.transactions" level="OFF" />
    <logger name="altitude.core.actors" level="ERROR" />
    <logger name="org.apache" level="ERROR" />
    <logger name="org.xnio" level="OFF" />
    <logger name="org.jboss" level="OFF" />
    <logger name="io.undertow" level="OFF" />

</configuration>

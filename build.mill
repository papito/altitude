//| mill-version: 1.0.6
//| mvnDeps:
//| - com.goyeau::mill-scalafix::0.6.0
//| - "com.lihaoyi::mill-contrib-twirllib:$MILL_VERSION"

package build

import com.goyeau.mill.scalafix.ScalafixModule

import mill._, scalalib._, publish._

object altitude extends ScalaModule with ScalafixModule with PublishModule with mill.twirllib.TwirlModule {
  def scalaVersion = "3.6.3"

  private val _twirlVersion = "1.6.8"
  def twirlVersion: T[String] = _twirlVersion

  private val caskVersion = "0.9.7"
  
  private val logbackVersion = "1.5.16"
  private val pekkoVersion = "1.1.2"
  private val javacppVersion = "1.5.10"

  def mainClass: T[Option[String]] = Some("altitude.core.App")

  def publishVersion = "0.1.0-SNAPSHOT"

  def scalacOptions: Task.Simple[Seq[String]] = Seq(
    "-deprecation",
    "-language:postfixOps",
    "-language:implicitConversions",
    "-feature",
    "-Wunused:imports",
    "-encoding", "UTF-8",
    "-unchecked",
    "-rewrite",
    "-source", "3.4-migration",
    "-Wconf:msg=.*E198.*&src=.*/out/altitude/compileTwirl.dest/.*:s"
  )

  def pomSettings: T[PomSettings] = PomSettings(
    description = "Altitude DAM",
    organization = "altitude-dam",
    url = "https://github.com/papito/altitude",
    licenses = Seq(License.MIT),
    versionControl = VersionControl.github("papito", "altitude"),
    developers = Seq.empty
  )

  private val coreDeps = Seq(
    mvn"com.lihaoyi::cask:$caskVersion",
    mvn"com.lihaoyi::ujson:3.3.1",
    mvn"com.lihaoyi::upickle:3.3.1",
    mvn"ch.qos.logback:logback-classic:$logbackVersion",

    mvn"com.typesafe:config:1.4.3",
    mvn"com.typesafe.play::twirl-api:${_twirlVersion}",

    mvn"commons-io:commons-io:2.18.0",
    mvn"commons-codec:commons-codec:1.17.1",
    mvn"commons-dbutils:commons-dbutils:1.8.1",
    mvn"commons-logging:commons-logging:1.3.4",
    mvn"commons-fileupload:commons-fileupload:1.5",
    mvn"org.mindrot:jbcrypt:0.4",
    mvn"dev.paseto:jpaseto-api:0.7.0",
    mvn"dev.paseto:jpaseto-impl:0.7.0",
    mvn"dev.paseto:jpaseto-jackson:0.7.0",
    mvn"dev.paseto:jpaseto-bouncy-castle:0.7.0",

    mvn"org.postgresql:postgresql:42.7.4",
    mvn"org.xerial:sqlite-jdbc:3.51.2.0",

    mvn"com.drewnoakes:metadata-extractor:2.19.0",
    mvn"org.apache.tika:tika-core:3.0.0",
    mvn"org.apache.tika:tika-parsers:3.0.0",
    mvn"org.apache.tika:tika-parser-image-module:3.0.0",

    mvn"org.apache.pekko::pekko-actor-typed:$pekkoVersion",
    mvn"org.apache.pekko::pekko-stream-typed:$pekkoVersion",
  )

  def runMvnDeps: Task.Simple[Seq[Dep]] = Seq(
    mvn"org.slf4j:slf4j-api:2.0.16",
    mvn"ch.qos.logback:logback-classic:1.5.14",
  )

  private def detectPlatform(): String = {
    val os = sys.props("os.name").toLowerCase
    val arch = sys.props("os.arch").toLowerCase

    (os, arch) match {
      case (os, arch) if os.contains("mac") && (arch.contains("aarch64") || arch.contains("arm")) =>
        "macosx-arm64"
      case (os, _) if os.contains("mac") =>
        "macosx-x86_64"
      case (os, arch) if os.contains("linux") && (arch.contains("aarch64") || arch.contains("arm")) =>
        "linux-arm64"
      case (os, _) if os.contains("linux") =>
        "linux-x86_64"
      case (os, _) if os.contains("win") =>
        "windows-x86_64"
      case _ =>
        throw new RuntimeException(s"Unsupported platform: os=$os, arch=$arch")
    }
  }

  private val platform: String = detectPlatform()

  private val bytedecoPresetLibs = Seq(
    "opencv" -> "4.9.0",
    "ffmpeg" -> "6.1.1",
    "openblas" -> "0.3.26",
    "opencv-platform" -> "4.9.0",
  ).flatMap {
    case (lib, ver) => Seq(
      // Add both: dependency and its native binaries for the current platform
      mvn"org.bytedeco:$lib:$ver-$javacppVersion",
      mvn"org.bytedeco:$lib:$ver-$javacppVersion-$platform"
    )
  }

  def mvnDeps: Task.Simple[Seq[Dep]] = coreDeps ++ bytedecoPresetLibs

  def generatedSources: T[Seq[PathRef]] = Task { Seq(compileTwirl().classes) }

  private def staticResources: T[PathRef] = Task.Source(moduleDir / "static")

  override def resources: T[Seq[PathRef]] = Task {
    val staticSrcDir = staticResources().path
    val destDir = Task.dest
    val staticDestDir = destDir / "static"

    // Copy static files to task output directory for JAR packaging
    if (os.exists(staticSrcDir)) {
      os.copy(staticSrcDir, staticDestDir, replaceExisting = true, createFolders = true, mergeFolders = true)
    }

    super.resources() ++ Seq(PathRef(destDir))
  }

  object test extends ScalaTests with TestModule.ScalaTest {
    def mvnDeps: Task.Simple[Seq[Dep]] = Seq(
      mvn"org.apache.pekko::pekko-testkit:$pekkoVersion",
      mvn"com.lihaoyi::utest::0.8.4",
      mvn"com.lihaoyi::requests::0.9.0",
      mvn"org.scalatest::scalatest:3.2.19",
      mvn"org.mockito:mockito-core:5.14.2"
    )
  }
}

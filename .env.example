# Settings of `docker compose up` (compose.yaml). Copy this file to .env and uncomment what applies; with every line
# commented, as here, Altitude runs on its defaults: SQLite, port 8080, UTC. A change takes effect at the next
# `docker compose up -d`.

# The server's time zone. Set it before the first Import: Date Imported's day is a day in this zone.
#TZ=Europe/Berlin

# The host port Altitude is published on.
#ALTITUDE_PUBLISH_PORT=8080

# Sign-in over plain HTTP. A browser keeps the session cookie over HTTPS, or over plain HTTP on localhost alone, so
# http://<a LAN or VPN address>:8080 needs this line. Leave it out behind an HTTPS proxy.
#ALTITUDE_SECURE_COOKIES=false

# PostgreSQL instead of SQLite: all three lines, with a password of your own. They are the switch: the profile starts
# the PostgreSQL container, and the engine points Altitude at it. Without a password neither starts. The two engines
# share no data: switching starts an empty database.
#COMPOSE_PROFILES=postgres
#ALTITUDE_DB_ENGINE=postgres
#ALTITUDE_DB_POSTGRES_PASSWORD=

# Logging: text or json (one object a line), and TRACE, DEBUG, INFO, WARN, ERROR or OFF.
#ALTITUDE_LOG_FORMAT=json
#ALTITUDE_LOG_LEVEL=INFO

# The most threads an import uses, for a machine short of memory: at least 2.
#ALTITUDE_IMPORT_PARALLELISM_MAX=2
